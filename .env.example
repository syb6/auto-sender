# Environment template for the Discord self-bot.
#
# 1. Copy this file to `.env`:   cp .env.example .env
# 2. Fill in your token below.
#
# `.env` is already listed in .gitignore — never commit it, never share it.
# bot.py loads this file automatically; alternatively set the variable in
# your shell or Windows user environment (it takes precedence over this file).

DISCORD_TOKEN=
